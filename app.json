{
  "expo": {
    "name": "نقش من",
    "slug": "naghshman",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/meydan-icon.png",
    "backgroundColor": "#dc2626",
    "primaryColor": "#dc2626",
    "scheme": "naghshman",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/meydan-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dc2626",
        "foregroundImage": "./assets/images/meydan-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ir.naghshman.app",
      "versionCode": 1,
      "backgroundColor": "#dc2626",
      "userInterfaceStyle": "light"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/meydan-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#dc2626",
          "image": "./assets/images/meydan-icon-foreground.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      [
        "./plugins/with-android-release-properties.cjs",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true,
            "gifEnabled": false,
            "webpEnabled": false,
            "webpAnimated": false
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Yekan.ttf"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4788dfb-4695-40d8-bfa6-774aeae4e836"
      }
    }
  }
}
