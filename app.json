{
  "expo": {
    "name": "نقش من",
    "slug": "naghshman",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/meydan-icon.png",
    "backgroundColor": "#ffffff",
    "primaryColor": "#dc2626",
    "scheme": "naghshman",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/meydan-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dc2626",
        "foregroundImage": "./assets/images/meydan-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ir.naghshman.app",
      "versionCode": 2,
      "backgroundColor": "#ffffff",
      "userInterfaceStyle": "automatic",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/meydan-icon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-launch-splash.cjs",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "./plugins/with-android-release-properties.cjs",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true,
            "gifEnabled": false,
            "webpEnabled": false,
            "webpAnimated": false
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Yekan.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "IRANSansX",
                "fontDefinitions": [
                  { "path": "./assets/fonts/IRANSansX-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/IRANSansX-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/IRANSansX-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/IRANSansX-Regular.ttf",
              "./assets/fonts/IRANSansX-Medium.ttf",
              "./assets/fonts/IRANSansX-Bold.ttf"
            ]
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "نقش من برای انتخاب و ارسال عکس و ویدیو به گالری دسترسی می‌خواهد.",
          "cameraPermission": "نقش من برای گرفتن عکس و فیلم و ارسال آن به دوربین دسترسی می‌خواهد.",
          "microphonePermission": "نقش من برای ضبط و ارسال پیام صوتی به میکروفون دسترسی می‌خواهد."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/meydan-icon-foreground.png",
          "color": "#dc2626",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4788dfb-4695-40d8-bfa6-774aeae4e836"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#c03636",
      "barStyle": "light-content",
      "translucent": false
    }
  }
}
